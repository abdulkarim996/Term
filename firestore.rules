rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null && 
             'email' in request.auth.token && 
             request.auth.token.email.lower() == 'kromsa2006@gmail.com';
    }

    // System configuration (Maintenance mode, Global announcements)
    match /system/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Users documents and subcollections
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());

      match /{allPaths=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      }
    }

    // Broadcast history
    match /system_broadcasts/{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
