import React, { useState, useEffect, useRef } from 'react'
import { Document, Page, pdfjs } from 'react-pdf'
import 'react-pdf/dist/Page/AnnotationLayer.css'
import 'react-pdf/dist/Page/TextLayer.css'
import { PDFDocument, rgb } from 'pdf-lib'
import type { DriveFile } from '../../lib/db'
import { useSettingsStore, useUIStore } from '../../store'
import { X, ChevronRight, ChevronLeft, Save, Trash2, Pen, Eraser, Loader2 } from 'lucide-react'
// Use local worker from public folder for bulletproof loading
pdfjs.GlobalWorkerOptions.workerSrc = '/pdf.worker.min.mjs'

interface Props {
  file: DriveFile
  onClose: () => void
}

type Point = { x: number, y: number }
type Stroke = { points: Point[], color: string, thickness: number, isEraser: boolean }

export default function FileAnnotator({ file, onClose }: Props) {
  const { googleAccessToken } = useSettingsStore()
  const { showToast } = useUIStore()

  const [loading, setLoading] = useState(true)
  const [saving, setSaving] = useState(false)
  const [fileBytes, setFileBytes] = useState<Uint8Array | null>(null)
  const [pdfUrl, setPdfUrl] = useState<string | null>(null)
  
  // PDF state
  const [numPages, setNumPages] = useState<number>(0)
  
  
  // Drawing state per page
  const [strokesByPage, setStrokesByPage] = useState<Record<number, Stroke[]>>({})
  const [currentStroke, setCurrentStroke] = useState<{ page: number, stroke: Stroke } | null>(null)
  
  const [color, setColor] = useState('#ff0000')
  const [isEraser, setIsEraser] = useState(false)
  const canvasRefs = useRef<Record<number, HTMLCanvasElement>>({})
  const containerRef = useRef<HTMLDivElement>(null)
  
  const isImage = file.mimeType?.includes('image')

  useEffect(() => {
    fetchFile()
    return () => {
      if (pdfUrl) URL.revokeObjectURL(pdfUrl)
    }
  }, [])

  const fetchFile = async () => {
    try {
      setLoading(true)
      const res = await fetch(`https://www.googleapis.com/drive/v3/files/${file.driveFileId}?alt=media`, {
        headers: { Authorization: `Bearer ${googleAccessToken}` }
      })
      if (!res.ok) throw new Error('Failed to fetch file')
      const buffer = await res.arrayBuffer()
      setFileBytes(new Uint8Array(buffer))
      const url = URL.createObjectURL(new Blob([buffer], { type: 'application/pdf' }))
      setPdfUrl(url)
    } catch (e) {
      showToast('خطأ في تحميل الملف، تأكد من صلاحيات حسابك', 'error')
      onClose()
    } finally {
      setLoading(false)
    }
  }

  // --- Drawing Logic ---
  useEffect(() => {
    drawAll()
  }, [strokesByPage, currentStroke, loading, numPages])

  const drawAll = () => {
    const pagesToDraw = isImage ? [1] : Array.from({ length: numPages }, (_, i) => i + 1)
    pagesToDraw.forEach(page => {
      const canvas = canvasRefs.current[page]
      if (!canvas) return
      const ctx = canvas.getContext('2d')
      if (!ctx) return
      
      ctx.clearRect(0, 0, canvas.width, canvas.height)
      
      const drawStroke = (s: Stroke) => {
        if (s.points.length < 2) return
        ctx.beginPath()
        ctx.moveTo(s.points[0].x, s.points[0].y)
        for (let i = 1; i < s.points.length; i++) {
          ctx.lineTo(s.points[i].x, s.points[i].y)
        }
        ctx.strokeStyle = s.isEraser ? '#ffffff' : s.color
        ctx.lineWidth = s.isEraser ? 20 : s.thickness
        ctx.lineCap = 'round'
        ctx.lineJoin = 'round'
        ctx.globalCompositeOperation = s.isEraser ? 'destination-out' : 'source-over'
        ctx.stroke()
      }

      const strokes = strokesByPage[page] || []
      strokes.forEach(drawStroke)
      if (currentStroke && currentStroke.page === page) drawStroke(currentStroke.stroke)
    })
  }

  const getPos = (e: React.MouseEvent | React.TouchEvent, canvas: HTMLCanvasElement) => {
    const rect = canvas.getBoundingClientRect()
    let clientX, clientY
    if ('touches' in e) {
      clientX = e.touches[0].clientX
      clientY = e.touches[0].clientY
    } else {
      clientX = (e as React.MouseEvent).clientX
      clientY = (e as React.MouseEvent).clientY
    }
    const scaleX = canvas.width / rect.width
    const scaleY = canvas.height / rect.height
    return {
      x: (clientX - rect.left) * scaleX,
      y: (clientY - rect.top) * scaleY
    }
  }

  const startDraw = (e: React.MouseEvent | React.TouchEvent, page: number) => {
    e.preventDefault()
    const canvas = canvasRefs.current[page]
    if (!canvas) return
    setCurrentStroke({ page, stroke: { points: [getPos(e, canvas)], color, thickness: 3, isEraser } })
  }

  const moveDraw = (e: React.MouseEvent | React.TouchEvent, page: number) => {
    e.preventDefault()
    if (!currentStroke || currentStroke.page !== page) return
    const canvas = canvasRefs.current[page]
    if (!canvas) return
    setCurrentStroke({
      page,
      stroke: {
        ...currentStroke.stroke,
        points: [...currentStroke.stroke.points, getPos(e, canvas)]
      }
    })
  }

  const endDraw = () => {
    if (currentStroke) {
      setStrokesByPage(prev => ({
        ...prev,
        [currentStroke.page]: [...(prev[currentStroke.page] || []), currentStroke.stroke]
      }))
      setCurrentStroke(null)
    }
  }

  // --- Saving Logic ---
  const saveFile = async (overwrite: boolean) => {
    if (!fileBytes) return
    setSaving(true)
    try {
      let finalBytes: Uint8Array;
      
      if (isImage) {
        // Just export the canvas merged with image
        // Very simplified: create a temporary canvas to merge
        // We will just alert for now since image save is complex via canvas if cross-origin
        showToast('حفظ الصور قيد التطوير، يرجى استخدام PDF', 'info')
        setSaving(false)
        return
      } else {
        // PDF Save
        const pdfDoc = await PDFDocument.load(fileBytes)
        const pages = pdfDoc.getPages()
        
        for (const [pageNumStr, strokes] of Object.entries(strokesByPage)) {
          const pNum = parseInt(pageNumStr)
          if (pNum < 1 || pNum > pages.length || strokes.length === 0) continue
          
          const page = pages[pNum - 1]
          const { width, height } = page.getSize()
          
          // Canvas size might differ from PDF size, we need to map coordinates
          const canvas = canvasRefs.current[pNum]
          if (!canvas) continue
          
          const scaleX = width / canvas.width
          const scaleY = height / canvas.height
          
          for (const s of strokes) {
            if (s.isEraser) continue // Very hard to do real erasure in PDF-lib, we ignore it for now
            if (s.points.length < 2) continue
            
            // Draw lines between points
            for (let i = 0; i < s.points.length - 1; i++) {
              const p1 = s.points[i]
              const p2 = s.points[i + 1]
              
              // PDF coordinates are bottom-left!
              page.drawLine({
                start: { x: p1.x * scaleX, y: height - (p1.y * scaleY) },
                end: { x: p2.x * scaleX, y: height - (p2.y * scaleY) },
                thickness: s.thickness * scaleX,
                color: hexToRgb(s.color),
                opacity: 1
              })
            }
          }
        }
        finalBytes = await pdfDoc.save()
      }

      // Upload to Drive
      const metadata: any = {
        name: overwrite ? file.name : `(معدل) ${file.name}`,
        mimeType: file.mimeType
      }
      
      let headers: Record<string, string> = {
        Authorization: `Bearer ${googleAccessToken}`
      }

      if (!overwrite) {
        // Fetch original file parents to save in the same folder
        try {
          const origRes = await fetch(`https://www.googleapis.com/drive/v3/files/${file.driveFileId}?fields=parents`, {
            headers
          })
          if (origRes.ok) {
            const origData = await origRes.json()
            if (origData.parents && origData.parents.length > 0) {
              metadata.parents = origData.parents
            }
          }
        } catch (err) {
          console.error("Could not fetch original parents", err)
        }
      }
      
      let url = ''
      let method = ''
      let body: any = null

      if (overwrite) {
        url = `https://www.googleapis.com/upload/drive/v3/files/${file.driveFileId}?uploadType=media`
        method = 'PATCH'
        headers['Content-Type'] = file.mimeType
        body = finalBytes
      } else {
        // Create new file requires metadata and content. We can do it in two steps to avoid multipart boundary complexity
        // Step 1: Create metadata
        const metaRes = await fetch('https://www.googleapis.com/drive/v3/files', {
          method: 'POST',
          headers: { ...headers, 'Content-Type': 'application/json' },
          body: JSON.stringify(metadata)
        })
        const metaData = await metaRes.json()
        
        // Step 2: Upload content
        url = `https://www.googleapis.com/upload/drive/v3/files/${metaData.id}?uploadType=media`
        method = 'PATCH'
        headers['Content-Type'] = file.mimeType
        body = finalBytes
      }

      const uploadRes = await fetch(url, { method, headers, body })

      if (!uploadRes.ok) throw new Error('Upload failed')
      
      showToast('تم الحفظ في Google Drive بنجاح! ✅', 'success')
      onClose()

    } catch (e) {
      console.error(e)
      showToast('حدث خطأ أثناء الحفظ', 'error')
    } finally {
      setSaving(false)
    }
  }

  const hexToRgb = (hex: string) => {
    const r = parseInt(hex.slice(1, 3), 16) / 255
    const g = parseInt(hex.slice(3, 5), 16) / 255
    const b = parseInt(hex.slice(5, 7), 16) / 255
    return rgb(r, g, b)
  }

  const clearAllPages = () => {
    if (window.confirm('هل أنت متأكد من مسح جميع التعديلات في الملف؟')) {
      setStrokesByPage({})
    }
  }

  if (loading) {
    return (
      <div className="fixed inset-0 z-50 bg-background/80 backdrop-blur-sm flex items-center justify-center">
        <div className="bg-surface-elevated p-8 rounded-2xl shadow-xl flex flex-col items-center gap-4">
          <Loader2 size={32} className="animate-spin text-accent-blue" />
          <p className="text-text-secondary font-medium">جاري تحميل الملف من Drive...</p>
        </div>
      </div>
    )
  }

  return (
    <div className="fixed inset-0 z-50 bg-background flex flex-col">
      {/* Header Toolbar */}
      <div className="h-16 bg-surface-elevated border-b border-surface-border flex items-center justify-between px-4">
        <div className="flex items-center gap-4">
          <button onClick={onClose} className="p-2 hover:bg-surface rounded-xl text-text-muted transition-colors">
            <X size={24} />
          </button>
          <div className="font-medium text-text-primary truncate max-w-[200px]">{file.name}</div>
        </div>

        {/* Tools */}
        <div className="flex items-center gap-2 bg-surface p-1 rounded-xl">
          <input type="color" value={color} onChange={e => { setColor(e.target.value); setIsEraser(false) }} className="w-8 h-8 rounded cursor-pointer" />
          <div className="w-px h-6 bg-surface-border mx-1" />
          <button onClick={() => setIsEraser(false)} className={`p-2 rounded-lg ${!isEraser ? 'bg-accent-blue/10 text-accent-blue' : 'text-text-muted hover:bg-surface-hover'}`}>
            <Pen size={18} />
          </button>
          <button onClick={() => setIsEraser(true)} className={`p-2 rounded-lg ${isEraser ? 'bg-accent-blue/10 text-accent-blue' : 'text-text-muted hover:bg-surface-hover'}`}>
            <Eraser size={18} />
          </button>
          <button onClick={clearAllPages} className="p-2 rounded-lg text-text-muted hover:text-accent-red hover:bg-surface-hover" title="مسح التعديلات">
            <Trash2 size={18} />
          </button>
        </div>

        {/* Save Options */}
        <div className="flex items-center gap-2">
          {saving ? (
             <div className="flex items-center gap-2 px-4 py-2 bg-accent-blue text-white rounded-xl opacity-70">
               <Loader2 size={18} className="animate-spin" /> جاري الحفظ...
             </div>
          ) : (
            <>
              <button onClick={() => saveFile(false)} className="px-4 py-2 bg-surface hover:bg-surface-hover text-text-primary rounded-xl text-sm font-medium transition-colors">
                حفظ كجديد
              </button>
              <button onClick={() => saveFile(true)} className="px-4 py-2 bg-accent-blue hover:bg-blue-600 text-white rounded-xl text-sm font-medium transition-colors flex items-center gap-2">
                <Save size={16} /> حفظ التعديل
              </button>
            </>
          )}
        </div>
      </div>

      {/* Content Area */}
      <div className="flex-1 overflow-auto bg-surface relative flex justify-center py-8" ref={containerRef}>
        {!fileBytes ? null : isImage ? (
           <div className="relative shadow-xl">
             <img src={URL.createObjectURL(new Blob([fileBytes]))} alt="file" className="max-w-full" onLoad={(e) => {
               const canvas = canvasRefs.current[1]
               if (canvas) {
                 canvas.width = e.currentTarget.width
                 canvas.height = e.currentTarget.height
               }
             }} />
             <canvas
                ref={(el) => { if (el) canvasRefs.current[1] = el }}
                className="absolute inset-0 touch-none cursor-crosshair"
                onMouseDown={e => startDraw(e, 1)} onMouseMove={e => moveDraw(e, 1)} onMouseUp={endDraw} onMouseOut={endDraw}
                onTouchStart={e => startDraw(e, 1)} onTouchMove={e => moveDraw(e, 1)} onTouchEnd={endDraw}
             />
           </div>
        ) : (
          <Document
            file={pdfUrl}
            onLoadSuccess={({ numPages }) => setNumPages(numPages)}
            onLoadError={(error) => {
              console.error('Error loading PDF:', error)
              showToast('خطأ PDF: ' + (error.message || error), 'error')
            }}
            className="flex flex-col items-center"
            loading={<Loader2 size={32} className="animate-spin text-accent-blue" />}
          >
            <div className="flex flex-col gap-6 w-full max-w-4xl px-4 py-8 mx-auto">
              {Array.from({ length: numPages }, (_, i) => i + 1).map(pageNum => (
                <div key={pageNum} className="relative shadow-xl bg-white mx-auto" style={{ width: 'fit-content' }}>
                  <Page 
                    pageNumber={pageNum} 
                    renderTextLayer={false}
                    renderAnnotationLayer={false}
                    onRenderSuccess={(page) => {
                      const canvas = canvasRefs.current[pageNum]
                      if (canvas) {
                        const viewport = page.getViewport({ scale: 1 })
                        canvas.width = viewport.width
                        canvas.height = viewport.height
                        drawAll()
                      }
                    }}
                  />
                  <canvas
                    ref={(el) => { if (el) canvasRefs.current[pageNum] = el }}
                    className="absolute inset-0 touch-none cursor-crosshair w-full h-full z-10"
                    onMouseDown={e => startDraw(e, pageNum)} onMouseMove={e => moveDraw(e, pageNum)} onMouseUp={endDraw} onMouseOut={endDraw}
                    onTouchStart={e => startDraw(e, pageNum)} onTouchMove={e => moveDraw(e, pageNum)} onTouchEnd={endDraw}
                  />
                </div>
              ))}
            </div>
          </Document>
        )}
      </div>
    </div>
  )
}
